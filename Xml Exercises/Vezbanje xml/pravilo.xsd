<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="pravilo"
    targetNamespace="http://tempuri.org/pravilo.xsd"
    elementFormDefault="qualified"
    xmlns="http://tempuri.org/pravilo.xsd"
    xmlns:mstns="http://tempuri.org/pravilo.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<!--glavni root element-->
	<xs:element name="knjige">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="knjiga" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="naziv" type="xs:string"/>
							<xs:element name="godina" type="xs:int"/>
						</xs:sequence>
						<xs:attribute name="id" type="xs:int" use="required"/>
						<xs:attribute name="autorId" type="xs:int" use="required"/>
						<xs:attribute name="knjigaId" type="xs:int" use="required"/>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>

